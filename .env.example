# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# --- Meta / Instagram ---
# From developers.facebook.com → your app → Settings → Basic
META_APP_SECRET=

# Any random string you choose; must match what you enter in Meta's webhook config
META_VERIFY_TOKEN=

# Long-lived Instagram User access token for @tinysoho
IG_ACCESS_TOKEN=

# Instagram Business Account ID (numeric) for @tinysoho
IG_USER_ID=

# --- Supabase ---
# Postgres connection string from Supabase project settings → Database → Connection string (URI)
DATABASE_URL=

# Supabase project URL (https://xxxx.supabase.co)
SUPABASE_URL=

# Service-role key from Supabase project settings → API (NEVER commit this)
SUPABASE_SERVICE_KEY=

# Public storage bucket name where DM images/PDFs live
SUPABASE_BUCKET=insta-resources

# --- Admin UI ---
# Email allowed to log into the admin UI (single user). Other emails are rejected.
ADMIN_EMAIL=

# Origin (scheme + host, no trailing slash) of the admin UI for CORS, e.g. https://tinysoho.vercel.app
# Comma-separate multiple origins. Leave empty in dev to allow http://localhost:5173.
WEB_ORIGIN=
