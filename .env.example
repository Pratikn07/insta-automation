# --- Server ---
PORT=3000
NODE_ENV=development

# Background workers. Defaults TRUE — leave it unset in production.
#
# Set it to false ONLY for a local server you are running to work on the UI.
# There is one database and one Instagram account, so a second server with
# workers on is a second gate-queue worker sending real private replies, a
# second token refresher racing the deployed one, and duplicate Graph and
# Gemini spend — all against production, beside Railway doing the same work.
#
# WORKERS_ENABLED=false
LOG_LEVEL=debug

# --- Meta / Instagram ---
# From developers.facebook.com → your app → Settings → Basic
META_APP_SECRET=

# Any random string you choose; must match what you enter in Meta's webhook config
META_VERIFY_TOKEN=

# Long-lived Instagram User access token for @tinysoho
IG_ACCESS_TOKEN=

# Instagram Business Account ID (numeric) for @tinysoho
IG_USER_ID=

# --- Supabase ---
# Postgres connection string from Supabase project settings → Database → Connection string (URI)
DATABASE_URL=
# Optional in development. In production, point this at Supabase's direct
# database endpoint so migrations do not run through transaction pooling.
DIRECT_URL=

# Supabase project URL (https://xxxx.supabase.co)
SUPABASE_URL=

# Service-role key from Supabase project settings → API (NEVER commit this)
SUPABASE_SERVICE_KEY=

# Public storage bucket name where DM images/PDFs live
SUPABASE_BUCKET=insta-resources

# --- Admin UI ---
# Email allowed to log into the admin UI (single user). Other emails are rejected.
ADMIN_EMAIL=

# Origin (scheme + host, no trailing slash) of the admin UI for CORS, e.g. https://tinysoho.vercel.app
# Comma-separate multiple origins. Leave empty in dev to allow http://localhost:5173.
WEB_ORIGIN=

# --- Upcoming automations ---
# Attach a keyword to a post Instagram hasn't published yet. Meta exposes no
# scheduled queue, so a worker watches for a post whose caption contains the word
# and attaches it then.
#
# Shipped ON, unlike guide delivery, because off-with-the-UI-live is the one
# configuration that is worse than not having the feature: while a setup reserves
# a word and the flag is off, commentHandler returns early, so that word gets no
# reply at all — not even the ordinary keyword's. With no setups the feature is
# genuinely inert (the worker returns idle before calling Meta), and it sends no
# messages of its own — the worst a bug does is attach a keyword to the wrong
# post, which is deletable.
#
# The schema still defaults to false, so an unset var fails closed.
UPCOMING_AUTOMATIONS_ENABLED=true

# --- Insights (reel analysis) ---
# Newer Graph API version used ONLY for insights/demographics/media_audio_type.
# The messaging/comment/gate flow stays on v21.0. Default v23.0.
INSIGHTS_GRAPH_VERSION=v23.0

# Google AI Studio key (https://aistudio.google.com/apikey). Optional — without it
# the app boots fine but reel content analysis (US-fit scoring) is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard daily spend cap for Gemini analysis (USD). Full ~300-reel catalog ≈ $1.20.
GEMINI_DAILY_BUDGET_USD=5
# Reels analyzed per Gemini worker tick.
GEMINI_BATCH=5
# Worker pacing (ms): snapshot every ~6h (self-throttled), Gemini queue every 2m.
SNAPSHOT_INTERVAL_MS=21600000
FEED_FOLLOW_SNAPSHOT_INTERVAL_MS=21600000
GEMINI_QUEUE_INTERVAL_MS=120000

# --- AI (private Codex runtime) ----------------------------------------------
# All optional: leave unset and the Assistant answers 503 ai_not_configured while
# webhooks, gates and guide delivery carry on untouched.
# The separate codex-runtime Railway service uses these core values (do not load
# them into the API process):
# PORT=3001
# CODEX_HOME=/data/codex
# CODEX_WORKSPACE=/tmp/tinysoho-codex-workspace
# RUNTIME_SHARED_SECRET=<64-character secret>
# Private Railway URL of the codex-runtime service, and the bearer this API sends.
CODEX_RUNTIME_URL=
CODEX_RUNTIME_TOKEN=
# Bearer the RUNTIME presents when calling back for the advisor's three read-only
# tools. Separate from CODEX_RUNTIME_TOKEN so each direction rotates independently.
# Set the same value as TINY_SOHO_INTERNAL_TOKEN in the runtime's env. Unset here
# means /internal/ai fails closed with 503 rather than serving unauthenticated.
TINY_SOHO_INTERNAL_TOKEN=
# Initial shadow rollout: create review-only drafts while follow-ups and sending
# remain disabled. AI_SEND_ENABLED stays false through shadow verification.
AI_DRAFTS_ENABLED=true
AI_FOLLOW_UPS_ENABLED=false
AI_SEND_ENABLED=false
AI_ADVISOR_ENABLED=false
# Creator cover authoring and every parent-facing guide enhancement ship off.
GUIDE_COVER_AUTHORING_ENABLED=false
# Strict access can be enabled only at deploy time, then stopped immediately in
# the console. It still reaches nobody unless an exact controlled account or
# guide ID is listed below. Leave both lists empty for an inert deployment.
GUIDE_FOLLOW_GATE_V2_ENABLED=false
GUIDE_FOLLOW_GATE_V2_COHORT_IG_USER_IDS=
GUIDE_FOLLOW_GATE_V2_RESOURCE_IDS=
# Enable only after the current Instagram quick-reply/template capability has
# been proven on the controlled account. Text fallback remains available off.
GUIDE_RICH_GATE_ENABLED=false
# Voice given to the drafter. Never instructs it to diagnose or shame a parent.
AI_BRAND_VOICE=Warm, practical, concise, and supportive. Never diagnose or shame a parent.
# Draft queue worker pacing (ms).
AI_DRAFT_INTERVAL_MS=15000

# --- DM Recovery Reminders ---
# Master kill switch for automated public recovery comments. Off by default.
DM_RECOVERY_ENABLED=false
# Legacy v1 only: hours to wait after gate DM acceptance. V2 ignores this value
# and freezes eligibility at 2 or 6 hours from acceptance according to its arm.
DM_RECOVERY_DELAY_HOURS=10
# Rolling cooldown hours: max 1 public recovery comment per Instagram user in 24 hours (default 24).
DM_RECOVERY_COOLDOWN_HOURS=24
# Recovery worker tick pacing (ms). Default 60000.
DM_RECOVERY_WORKER_INTERVAL_MS=60000
# Max recovery candidates processed per worker tick. Default 5.
DM_RECOVERY_BATCH_SIZE=5
# Max public recovery comments reserved in any rolling 24-hour window. Default 100.
DM_RECOVERY_GLOBAL_DAILY_CAP=100
# Max public recovery comments sent per hour across all users. Default 30.
DM_RECOVERY_HOURLY_CAP=30
# Worker claim lease duration (ms). Default 900000 (15 minutes).
DM_RECOVERY_LEASE_MS=900000
# Max public comment send attempts before marking failure. Default 3.
DM_RECOVERY_MAX_ATTEMPTS=3
# Retry base backoff for safe retryable failures (ms). Default 300000 (5 minutes).
DM_RECOVERY_RETRY_BASE_MS=300000
# Legacy v1 only: percentage withheld in its treatment/control experiment. V2
# ignores this value and uses a code-frozen 45% / 45% / 10% allocation.
DM_RECOVERY_HOLDOUT_PERCENT=10
# Withhold the PUBLIC recovery comment from people whose name/username reads as
# South Asian with high confidence (inferOrigin: a non-Latin script or an
# unambiguous name token). The reminder is a public reply on the person's own
# comment, so it is visible to their followers too — spending that reach outside
# the Western market the account sells to.
#
# This is a name-based PROXY, never measured geography: Meta exposes no per-user
# country. Low-confidence and `unknown` calls (~70% of this audience) still
# receive the reminder, so the gate cannot quietly cancel the feature. Suppressed
# rows are recorded with reason `audience_out_of_market` and stay in the
# experiment denominators.
DM_RECOVERY_WESTERN_ONLY=false
# Upgrade the name-token origin guess with a Gemini pass, stored on
# ig_users.inferred_origin. Measured on 50 real gate users: the token list
# caught 3, the model caught 22, with no Western false positives and correct
# abstention on every no-name account. Backfilling all ~3.8k users costs ~$0.27
# once, then ~$0.15/month at current signup rate, against GEMINI_DAILY_BUDGET_USD.
#
# Independent of DM_RECOVERY_WESTERN_ONLY on purpose: turn this on first, audit
# the column, then turn the gate on. Requires GEMINI_API_KEY.
DM_RECOVERY_ORIGIN_LLM_ENABLED=false
DM_RECOVERY_ORIGIN_BATCH_SIZE=25
DM_RECOVERY_ORIGIN_INTERVAL_MS=120000
# Safe legacy default. Keep v1 configured while deploying the compatible schema
# and code. Activate v2 only through docs/dm-recovery-timing-experiment-runbook.md.
DM_RECOVERY_EXPERIMENT_VERSION=read-recovery-v1
# ISO 8601 enrollment bounds. Legacy v1 used a two-week window. V2 requires a
# 28-to-42-day window; configure the initial end exactly 42 days after the start.
DM_RECOVERY_EXPERIMENT_START_AT=
DM_RECOVERY_EXPERIMENT_END_AT=
# Legacy v1 only. V2 must keep this false and rejects true at startup; a future
# rollout requires an owner-approved, separately versioned configuration change.
DM_RECOVERY_POST_EXPERIMENT_ENABLED=false
# Allowlisted Graph error signatures (code:subcode) for verified settings blockage.
# Leave empty until a real structured Meta response has been captured and verified.
# HAZARD: do not add 100:2534025 without further evidence. That signature means
# "the comment is invalid for a private reply", which covers a deleted comment, a
# comment older than seven days, and one already replied to — not only blocked
# message-request settings. Allowlisting it would post "your message-request
# settings blocked it" to people none of that applies to.
# Malformed entries are rejected at startup rather than silently ignored.
DM_RECOVERY_SETTINGS_BLOCKED_SIGNATURES=
# Health monitor sample size and thresholds.
DM_RECOVERY_HEALTH_SAMPLE_SIZE=50
DM_RECOVERY_FAILURE_RATE_PERCENT=50
DM_RECOVERY_BACKLOG_ALERT_THRESHOLD=500
DM_RECOVERY_DB_FAILURE_THRESHOLD=3
DM_RECOVERY_MIN_ACCEPTED_HEALTH_SAMPLE=20

# --- Funnels (analytics, read-only) ---
# Optional. A SELECT-only Postgres role used by the funnel MCP server declared
# in .mcp.json. NOT the app's DATABASE_URL and NOT the service key — see
# docs/funnels.md for the exact grants. Leave unset to keep the server inert.
FUNNEL_DATABASE_URL_READONLY=
