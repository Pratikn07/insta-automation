node_modules/
dist/
.env
# Any .env variant — backups included. A file like .env.bak.1786082926 was not
# covered by the three patterns below it and would have been swept up by a bare
# `git add -A`, putting live production credentials into git history.
.env.*
!.env.example
.env.local
.env.*.local
*.log
.DS_Store

# Prisma
prisma/migrations/dev.db*

# Playwright MCP session artifacts (console logs + page snapshots)
.playwright-mcp/
.wrangler/

# Local Superpowers brainstorming companion
.superpowers/

# Local isolated development worktrees
.worktrees/

# Claude Code's local session state: launch.json, settings.local.json, and a
# second worktree home under .claude/worktrees that reached 1.6 GB. None of it
# is shared, and nothing here has ever been tracked.
.claude/*

# Exception: the graphify skill, the shared hook config and the SessionStart
# hook are project config, not session state, so they are tracked. Everything
# else under .claude/ stays ignored by the rule above (incl. settings.local.json).
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/graphify/

# graphify's knowledge graph. Tracked so a fresh session can query it without a
# rebuild; the SessionStart hook runs `graphify update .` to refresh it. Paths
# inside graph.json are repo-relative, so it is portable across machines.
# The local extraction cache, analysis scratch and .graphify_root are not
# (.graphify_root stores the absolute path of the machine that built the graph).
graphify-out/cache/
graphify-out/.graphify_analysis.json
graphify-out/.graphify_root
graphify-out/.graphify_incremental.json
graphify-out/.graphify_learning.json
graphify-out/.graphify_python
graphify-out/.vocab.txt
# Per-session query scratch and self-notes: local to whoever ran the query.
graphify-out/memory/
graphify-out/reflections/
# graphify snapshots the previous graph into a dated dir on every update; that
# is a full ~6 MB copy per day, so keep the backups local.
graphify-out/20*/

# Impeccable decision-page session state. DESIGN.md and .impeccable/design.json
# are design authority and are tracked; these are per-run scratch.
.impeccable/questions/
.vercel
.expanded-recovery-rollout.state.json
.expanded-recovery-rollout.state.json.cleanup-required
.expanded-recovery-rollout.state.json.lock/
# Timestamped copies of the rollout state above, which the three patterns here
# do not cover. Each snapshot carries Railway project/service/environment IDs
# and a release SHA, so these are operational records, not source.
.rollout-audit-backups/
