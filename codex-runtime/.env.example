PORT=3001
NODE_ENV=development
CODEX_HOME=/tmp/tinysoho-codex-home
CODEX_WORKSPACE=/tmp/tinysoho-codex-workspace
RUNTIME_SHARED_SECRET=replace-with-at-least-32-random-characters

# Where the runtime calls BACK for the advisor's three read-only data tools.
# Both optional: without them DM drafting still works (it is tool-free) and only
# the advisor reports itself unavailable. TINY_SOHO_INTERNAL_TOKEN must match the
# value of the same name in the API's env, and is separate from
# RUNTIME_SHARED_SECRET so each direction rotates independently.
TINY_SOHO_API_URL=
TINY_SOHO_INTERNAL_TOKEN=
