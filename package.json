{
  "name": "insta-automation",
  "version": "0.1.0",
  "description": "Instagram comment-to-DM automation for @tinysoho",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node scripts/copy-guide-cover-assets.mjs",
    "start": "node dist/src/migrate.js && node dist/src/server.js",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx scripts/seed-keywords.ts",
    "standardize:public-replies": "tsx scripts/standardize-public-replies.ts",
    "audit:guide-message-lengths": "tsx scripts/audit-guide-message-lengths.ts",
    "audit:guide-access-recovery": "tsx scripts/guide-access-recovery.ts",
    "verify:meta-guide-gate": "tsx scripts/meta-guide-gate-capability-spike.ts",
    "verify:link-guide": "tsx scripts/link-guide-capability-spike.ts",
    "render:guide-cover-snapshots": "tsx scripts/render-approved-guide-cover-snapshots.ts",
    "check:guide-delivery-bypasses": "node scripts/check-guide-delivery-bypasses.mjs",
    "funnel": "tsx scripts/funnel-report.ts",
    "recovery:select-expanded": "tsx scripts/select-expanded-historical-recovery.ts",
    "test": "vitest run",
    "redact:legacy-provider-bodies": "tsx scripts/redact-legacy-provider-bodies.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "^2.46.1",
    "axios": "^1.7.9",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fontkit": "2.0.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/fontkit": "2.0.9",
    "@types/node": "^22.10.2",
    "@types/supertest": "7.2.1",
    "pg": "^8.21.0",
    "prisma": "^5.22.0",
    "supertest": "7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
