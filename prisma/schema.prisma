generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Keyword {
  id             String         @id @default(uuid()) @db.Uuid
  keyword        String
  mediaId        String?        @map("media_id")
  mediaCaption   String?        @map("media_caption")
  mediaPermalink String?        @map("media_permalink")
  resourceId     String         @map("resource_id") @db.Uuid
  publicReply    String         @map("public_reply")
  gateMessage    String         @map("gate_message")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  resource       Resource       @relation(fields: [resourceId], references: [id])
  conversations  Conversation[]

  @@unique([keyword, mediaId])
  @@map("keywords")
}

model Resource {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at")

  messages    ResourceMessage[]
  keywords    Keyword[]

  @@map("resources")
}

enum ResourceMessageType {
  text
  image
  pdf

  @@map("resource_message_type")
}

model ResourceMessage {
  id         String              @id @default(uuid()) @db.Uuid
  resourceId String              @map("resource_id") @db.Uuid
  order      Int
  type       ResourceMessageType
  body       String?
  mediaUrl   String?             @map("media_url")

  resource   Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, order])
  @@map("resource_messages")
}

enum ConversationState {
  awaiting_done
  completed
  expired

  @@map("conversation_state")
}

model Conversation {
  id          String            @id @default(uuid()) @db.Uuid
  igUserId    String            @map("ig_user_id")
  keywordId   String            @map("keyword_id") @db.Uuid
  state       ConversationState @default(awaiting_done)
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")

  keyword     Keyword           @relation(fields: [keywordId], references: [id])

  @@index([igUserId, state])
  @@index([state, createdAt])
  @@map("conversations")
}

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("event_log")
}
