  id                String                      @id @default(uuid()) @db.Uuid
  reservationToken  String                      @unique(map: "public_recovery_dispatch_reservation_token_key") @map("reservation_token") @db.Uuid
  igUserId          String                      @map("ig_user_id")
  sourceKind        PublicRecoverySourceKind    @map("source_kind")
  sourceId          String                      @map("source_id") @db.Uuid
