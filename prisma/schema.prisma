/// One row per comment webhook we have acted on.
///
/// Meta delivers webhooks at least once, and handleComment is not otherwise
/// idempotent: a repeat ran end to end, posting a second public reply and
/// sending a second gate DM to the same person. The primary key is the guard —
/// the insert either wins or raises, so two deliveries interleaving cannot both
/// pass a check-then-act window.
model ProcessedComment {
  commentId String   @id @map("comment_id")
  igUserId  String   @map("ig_user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("processed_comment")
}

/// The reconciled relationship between an alias journey and its canonical owner.
/// `recovered` = a sibling journey completed the request; `superseded` = none did
/// and this row simply is not the owner.
enum JourneyReconciledState {
  canonical
  recovered
  superseded

  @@map("journey_reconciled_state")
}

/// What one trigger did on arrival. `replayed_comment` is the exact-duplicate
/// webhook case absorbed by the unique commentId; the rest describe a genuinely
/// new comment landing on a new, live, or finished intent.
enum JourneyTriggerDisposition {
  new_journey
  reused_active
  already_completed_recently
  replayed_comment

  @@map("journey_trigger_disposition")
}

enum JourneyPublicAcknowledgementState {
  pending
  confirmed
  failed
  uncertain

  @@map("journey_public_acknowledgement_state")
}

/// One person-keyword request, owning a 48-hour window and the single conversation
/// responsible for it.
///
/// Two comments for the same guide are two different Meta comment ids, so webhook
/// idempotency cannot merge them — 342 of 423 production repeat triggers arrived
/// inside 48 hours, each one a duplicate gate DM. This table is what collapses
/// them to one journey while `JourneyTrigger` keeps every originating comment.
model JourneyIntent {
  id                      String                 @id @default(uuid()) @db.Uuid
  igUserId                String                 @map("ig_user_id")
  keywordId               String                 @map("keyword_id") @db.Uuid
  /// Nullable only so reconciliation can insert an intent before picking its owner.
  canonicalConversationId String?                @map("canonical_conversation_id") @db.Uuid
  windowStartedAt         DateTime               @map("window_started_at") @db.Timestamptz(3)
  /// The 48-hour boundary is measured from HERE, not windowStartedAt, so a person
  /// re-asking keeps one journey alive instead of opening a second.
  lastTriggerAt           DateTime               @map("last_trigger_at") @db.Timestamptz(3)
  windowExpiresAt         DateTime               @map("window_expires_at") @db.Timestamptz(3)
  reconciledState         JourneyReconciledState @default(canonical) @map("reconciled_state")
  completedAt             DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  keyword               Keyword                      @relation(fields: [keywordId], references: [id], onDelete: Restrict)
  canonicalConversation Conversation?                @relation("IntentCanonicalConversation", fields: [canonicalConversationId], references: [id], onDelete: SetNull)
  aliasConversations    Conversation[]               @relation("ConversationCanonicalIntent")
  triggers              JourneyTrigger[]
  recoveryCandidates    RecoveryCandidate[]
  selectionExclusions   RecoverySelectionExclusion[]

  /// Exactly one intent owns a person-keyword window. Two simultaneous first
  /// comments race here: one insert wins, the loser reads the winner and attaches.
  @@unique([igUserId, keywordId, windowStartedAt], map: "journey_intent_person_keyword_window_key")
  /// Lets a trigger's composite FK prove that its denormalized keyword belongs
  /// to the same intent, rather than merely pointing at any valid keyword row.
  @@unique([id, keywordId], map: "journey_intent_id_keyword_key")
  @@index([igUserId, keywordId, lastTriggerAt(sort: Desc)], map: "journey_intent_person_keyword_last_trigger_idx")
  @@index([reconciledState])
  @@map("journey_intent")
}

/// One globally unique Instagram source comment. Keyword matching is modeled by
/// JourneyTrigger associations so one comment can legitimately request several
/// guides without duplicating or discarding the source evidence.
model JourneySourceEvent {
  id              String   @id @default(uuid()) @db.Uuid
  commentId       String   @unique(map: "journey_source_event_comment_id_key") @map("comment_id")
  mediaId         String?  @map("media_id")
  firstReceivedAt DateTime @map("first_received_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  triggers JourneyTrigger[]

  @@map("journey_source_event")
}

/// One source-event-to-intent association. Retained for audit even when it drove
/// no automation, so aliases and distinct keyword matches are never lost.
model JourneyTrigger {
  id                           String                            @id @default(uuid()) @db.Uuid
  sourceEventId                String                            @map("source_event_id") @db.Uuid
  /// The best-effort legacy event-log observation used to reconstruct this
  /// association. Null for live rows when event logging was unavailable.
  sourceEventLogId             String?                           @map("source_event_log_id") @db.Uuid
  intentId                     String                            @map("intent_id") @db.Uuid
  keywordId                    String                            @map("keyword_id") @db.Uuid
  /// Nullable: a replayed comment attaches to an intent without opening a conversation.
  conversationId               String?                           @map("conversation_id") @db.Uuid
  receivedAt                   DateTime                          @map("received_at") @db.Timestamptz(3)
  triggerKind                  String                            @map("trigger_kind")
  disposition                  JourneyTriggerDisposition
  publicAcknowledgementState   JourneyPublicAcknowledgementState @default(pending) @map("public_acknowledgement_state")
  acknowledgementReplyId       String?                           @map("acknowledgement_reply_id")
  acknowledgementErrorCategory String?                           @map("acknowledgement_error_category")
  createdAt                    DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                          @updatedAt @map("updated_at") @db.Timestamptz(3)

  sourceEvent    JourneySourceEvent @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  sourceEventLog EventLog?          @relation("JourneyTriggerSourceLog", fields: [sourceEventLogId], references: [id], onDelete: SetNull)
  intent         JourneyIntent      @relation(fields: [intentId, keywordId], references: [id, keywordId], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([sourceEventId, intentId], map: "journey_trigger_source_intent_key")
  @@unique([sourceEventId, keywordId], map: "journey_trigger_source_keyword_key")
  @@index([intentId, receivedAt])
  @@map("journey_trigger")
}

model JourneyReconciliationRun {
  id                    String    @id @default(uuid()) @db.Uuid
  sourceCutoff          DateTime  @map("source_cutoff") @db.Timestamptz(3)
  queryVersion          String    @map("query_version")
  mode                  String
  status                String
  approvedManifestRunId String?   @map("approved_manifest_run_id") @db.Uuid
  resumePosition        Int       @default(0) @map("resume_position")
  resumeCursor          String?   @map("resume_cursor")
  startedAt             DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(3)
  lastError             String?   @map("last_error")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  approvedManifest JourneyReconciliationRun?     @relation("ApprovedJourneyManifest", fields: [approvedManifestRunId], references: [id], onDelete: Restrict)
  writeRuns        JourneyReconciliationRun[]    @relation("ApprovedJourneyManifest")
  windows          JourneyReconciliationWindow[]

  @@index([mode, status, createdAt])
  @@map("journey_reconciliation_run")
}

model JourneyReconciliationWindow {
  id                  String   @id @default(uuid()) @db.Uuid
  runId               String   @map("run_id") @db.Uuid
  position            Int
  windowKey           String   @map("window_key")
  inputFingerprint    String   @map("input_fingerprint")
  proposedCanonicalId String   @map("proposed_canonical_id") @db.Uuid
  evidenceChoice      String   @map("evidence_choice")
  result              String
  conflictReason      String?  @map("conflict_reason")
  intentId            String?  @map("intent_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  run JourneyReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position], map: "journey_reconciliation_window_run_position_key")
  @@unique([runId, windowKey], map: "journey_reconciliation_window_run_key")
  @@index([result, conflictReason])
  @@map("journey_reconciliation_window")
}

/// `confirmed_failure` = the gate demonstrably never delivered. `unknown_read_pilot`
/// = Meta accepted the gate but no read receipt exists, which is NOT the same as
/// unread and is never labelled that way.
enum RecoveryCampaignPhase {
  confirmed_failure
  unknown_read_pilot

  @@map("recovery_campaign_phase")
}

/// Approval freezes selection, so a campaign never returns to draft.
enum RecoveryCampaignState {
  draft
  awaiting_approval
  running
  paused
  completed
  cancelled

  @@map("recovery_campaign_state")
}

enum RecoveryCandidateArm {
  treatment
  holdout

  @@map("recovery_candidate_arm")
}

/// `send_uncertain` is never retried automatically — the comment may have posted,
/// and a retry would double-post publicly.
enum RecoveryCandidateOutcome {
  pending
  sent
  send_failed
  send_uncertain
  suppressed
  cancelled
  holdout_withheld

  @@map("recovery_candidate_outcome")
}

enum RecoveryCampaignBatchStatus {
  active
  completed
  expired

  @@map("recovery_campaign_batch_status")
}

enum RecoveryCampaignHealthKind {
  complaint
  opt_out
  block
  negative_reply
  classifier_anomaly

  @@map("recovery_campaign_health_kind")
}

enum HistoricalAudienceSegment {
  western
  other
  unknown_cue
  unknown_generic
  unknown_no_name
  south_asian

  @@map("historical_audience_segment")
}

/// One owner-approved historical recovery campaign.
///
/// Selection is frozen at approval rather than re-run during the send: the
/// underlying data moves (origin verdicts are rewritten, people reply, journeys
/// complete), so a campaign that re-selected mid-send could contact somebody the
/// owner never approved.
model RecoveryCampaign {
  id                       String                     @id @default(uuid()) @db.Uuid
  phase                    RecoveryCampaignPhase
  state                    RecoveryCampaignState      @default(draft)
  /// Which selector produced this list. Editing filters creates a new version
  /// rather than mutating an approved snapshot.
  selectionVersion         String                     @map("selection_version")
  /// No candidate may be drawn from data after this instant, so re-running the
  /// same version reproduces the same list.
  sourceDataCutoff         DateTime                   @map("source_data_cutoff") @db.Timestamptz(3)
  commentFrom              DateTime?                  @map("comment_from") @db.Timestamptz(3)
  commentTo                DateTime?                  @map("comment_to") @db.Timestamptz(3)
  selectionLimit           Int?                       @map("selection_limit")
  holdoutPercent           Int                        @default(50) @map("holdout_percent")
  copyVersion              String                     @map("copy_version")
  batchSize                Int                        @default(1) @map("batch_size")
  hourlyCap                Int                        @default(3) @map("hourly_cap")
  dailyCap                 Int                        @default(10) @map("daily_cap")
  candidateCount           Int                        @default(0) @map("candidate_count")
  excludedCount            Int                        @default(0) @map("excluded_count")
  /// Hash of the normalized selector configuration. Null only on legacy campaigns;
  /// new approval requires it and the database rejects a duplicate selection identity.
  selectionFingerprint     String?                    @unique(map: "recovery_campaign_selection_fingerprint_key") @map("selection_fingerprint")
  eligibilityPolicyVersion String?                    @map("eligibility_policy_version")
  westernOnly              Boolean?                   @map("western_only")
  inboundWindowHours       Int                        @default(24) @map("inbound_window_hours")
  completionWindowHours    Int                        @default(48) @map("completion_window_hours")
  /// Canonical hash of every decision this selection made (QA-14). Two selections over
  /// the same cutoff and filters must agree; a different hash means the data moved.
  /// Null on campaigns created before the decision set was recorded.
  decisionHash             String?                    @map("decision_hash")
  audienceSegment          HistoricalAudienceSegment? @map("audience_segment")
  rolloutGroupId           String?                    @map("rollout_group_id") @db.Uuid
  rolloutGroupHourlyCap    Int?                       @map("rollout_group_hourly_cap")
  approvedBy               String?                    @map("approved_by")
  approvedAt               DateTime?                  @map("approved_at") @db.Timestamptz(3)
  startedAt                DateTime?                  @map("started_at") @db.Timestamptz(3)
  pausedAt                 DateTime?                  @map("paused_at") @db.Timestamptz(3)
  pauseReason              String?                    @map("pause_reason")
  endedAt                  DateTime?                  @map("ended_at") @db.Timestamptz(3)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidates               RecoveryCandidate[]
  exclusions               RecoverySelectionExclusion[]
  publicRecoveryDispatches PublicRecoveryDispatch[]
  batchRuns                RecoveryCampaignBatchRun[]
  healthObservations       RecoveryCampaignHealthObservation[]

  @@index([state])
  @@index([rolloutGroupId, state])
  @@map("recovery_campaign")
}

model RecoveryCampaignBatchRun {
  id             String                      @id @default(uuid()) @db.Uuid
  campaignId     String                      @map("campaign_id") @db.Uuid
  tickToken      String                      @map("tick_token") @db.Uuid
  allowance      Int
  consumed       Int                         @default(0)
  status         RecoveryCampaignBatchStatus @default(active)
  startedAt      DateTime                    @map("started_at") @db.Timestamptz(3)
  leaseExpiresAt DateTime                    @map("lease_expires_at") @db.Timestamptz(3)
  endedAt        DateTime?                   @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign RecoveryCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, tickToken])
  @@index([status, leaseExpiresAt])
  @@map("recovery_campaign_batch_run")
}

model RecoveryCampaignHealthObservation {
  id         String                     @id @default(uuid()) @db.Uuid
  campaignId String                     @map("campaign_id") @db.Uuid
  kind       RecoveryCampaignHealthKind
  sourceKey  String                     @map("source_key")
  observedAt DateTime                   @map("observed_at") @db.Timestamptz(3)
  safeDetail String?                    @map("safe_detail")
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  campaign RecoveryCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([campaignId, sourceKey])
  @@index([campaignId, kind, observedAt])
  @@map("recovery_campaign_health_observation")
}

/// One intent the selection considered and did not include, with the reason it was
/// dropped (QA-14).
///
/// Exclusions previously survived only as counts in an in-memory report, so "why was
/// this cohort only 1,007 people?" could not be answered from the record — before or
/// after approval. Kept out of RecoveryCandidate on purpose: every worker query and cap
/// count on that table assumes a row is someone we intend to contact.
model RecoverySelectionExclusion {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  intentId   String   @map("intent_id") @db.Uuid
  igUserId   String   @map("ig_user_id")
  keywordId  String   @map("keyword_id") @db.Uuid
  reason     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // All three cascade: an exclusion describes a decision about these rows, it does not
  // lay claim to them the way a candidate does. Nothing should stay undeletable to
  // preserve a note about why it was passed over.
  campaign RecoveryCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  intent   JourneyIntent    @relation(fields: [intentId], references: [id], onDelete: Cascade)
  keyword  Keyword          @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([campaignId, intentId])
  @@index([campaignId, reason])
  @@map("recovery_selection_exclusion")
}

/// One person a campaign may contact, frozen at selection time.
model RecoveryCandidate {
  id                       String                     @id @default(uuid()) @db.Uuid
  campaignId               String                     @map("campaign_id") @db.Uuid
  /// Denormalised from the campaign so a CHECK can enforce that evidence matches the
  /// phase. A trigger keeps it equal to the campaign's own phase.
  campaignPhase            RecoveryCampaignPhase      @map("campaign_phase")
  /// Feature 3 guarantees one intent per person-keyword window, which is what
  /// stops the same person being contacted twice for one request.
  intentId                 String                     @map("intent_id") @db.Uuid
  igUserId                 String                     @map("ig_user_id")
  conversationId           String?                    @map("conversation_id") @db.Uuid
  keywordId                String                     @map("keyword_id") @db.Uuid
  /// Rechecked immediately before send: a deleted comment must suppress rather
  /// than redirect the reply somewhere else.
  commentId                String                     @map("comment_id")
  mediaId                  String?                    @map("media_id")
  commentAt                DateTime                   @map("comment_at") @db.Timestamptz(3)
  keywordSnapshot          String                     @map("keyword_snapshot")
  publicReplyText          String                     @map("public_reply_text")
  evidence                 String
  selectionPosition        Int?                       @map("selection_position")
  sourceChoiceReason       String?                    @map("source_choice_reason")
  /// Exact member of the approved ordered source set authorized at dispatch start.
  dispatchCommentId        String?                    @map("dispatch_comment_id")
  /// What the origin filter believed at selection. ig_users is mutable, so the
  /// live value cannot reconstruct this later.
  audienceOrigin           String?                    @map("audience_origin")
  audienceOriginMethod     String?                    @map("audience_origin_method")
  audienceOriginConfidence String?                    @map("audience_origin_confidence")
  audienceSegment          HistoricalAudienceSegment? @map("audience_segment")
  arm                      RecoveryCandidateArm
  outcome                  RecoveryCandidateOutcome   @default(pending)
  eligibleAt               DateTime                   @map("eligible_at") @db.Timestamptz(3)
  claimedAt                DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt           DateTime?                  @map("claim_expires_at") @db.Timestamptz(3)
  /// Present only while a worker holds this row. Every release and finalise must
  /// present it, so a stale claimant cannot overwrite the winner's outcome.
  claimToken               String?                    @map("claim_token") @db.Uuid
  /// Durable attempt bookkeeping: without it a retryable failure retried every tick
  /// forever, because releasing the claim left no record that anything had happened.
  attempts                 Int                        @default(0)
  lastAttemptAt            DateTime?                  @map("last_attempt_at") @db.Timestamptz(3)
  /// Set immediately before the Graph call, inside the capacity reservation. A claimed
  /// row with this still null is provably pre-network: safe to release rather than park
  /// as send_uncertain, and it has NOT consumed a send slot.
  dispatchStartedAt        DateTime?                  @map("dispatch_started_at") @db.Timestamptz(3)
  nextAttemptAt            DateTime?                  @map("next_attempt_at") @db.Timestamptz(3)
  sentAt                   DateTime?                  @map("sent_at") @db.Timestamptz(3)
  publicReplyId            String?                    @map("public_reply_id")
  suppressionReason        String?                    @map("suppression_reason")
  reviewedAt               DateTime?                  @map("reviewed_at") @db.Timestamptz(3)
  laterInboundAt           DateTime?                  @map("later_inbound_at") @db.Timestamptz(3)
  laterCompletedAt         DateTime?                  @map("later_completed_at") @db.Timestamptz(3)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign     RecoveryCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  intent       JourneyIntent             @relation(fields: [intentId], references: [id], onDelete: Restrict)
  keyword      Keyword                   @relation(fields: [keywordId], references: [id], onDelete: Restrict)
  conversation Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sources      RecoveryCandidateSource[]

  /// The anti-duplicate invariant, enforced rather than assumed: one candidate per
  /// intent, and one per person, within a campaign.
  @@unique([campaignId, intentId], map: "recovery_candidate_campaign_intent_key")
  @@unique([campaignId, igUserId], map: "recovery_candidate_campaign_person_key")
  @@unique([campaignId, selectionPosition], map: "recovery_candidate_campaign_id_selection_position_key")
  @@index([outcome, eligibleAt])
  @@index([igUserId, sentAt])
  @@index([dispatchStartedAt], map: "recovery_candidate_dispatch_started_idx")
  @@map("recovery_candidate")
}

/// Immutable, owner-reviewed comment sources for one candidate, newest first.
model RecoveryCandidateSource {
  id           String   @id @default(uuid()) @db.Uuid
  candidateId  String   @map("candidate_id") @db.Uuid
  position     Int
  commentId    String   @map("comment_id")
  mediaId      String?  @map("media_id")
  receivedAt   DateTime @map("received_at") @db.Timestamptz(3)
  choiceReason String   @map("choice_reason")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  candidate RecoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, position], map: "recovery_candidate_source_candidate_id_position_key")
  @@unique([candidateId, commentId], map: "recovery_candidate_source_candidate_id_comment_id_key")
  @@index([commentId])
  @@map("recovery_candidate_source")
}

/// A console-set value for one flag. VALUES ONLY.
///
/// What the flag does, who it affects, and whether the console may change it live
/// in src/config/flagRegistry.ts — facts about the code, reviewed with the code.
///
/// An absent row means "no override": the resolver uses the deployed environment
/// value, so an empty table behaves exactly like production does today.
model FlagOverride {
  key          String   @id
  valueBool    Boolean? @map("value_bool")
  valuePercent Int?     @map("value_percent")
  updatedBy    String   @map("updated_by")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("flag_override")
}
