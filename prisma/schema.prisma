// One versioned AI suggestion for one inbound message.
//
// The three text columns are deliberately separate. `suggestedText` is what the
// model produced and is never rewritten; `workingText` is the owner's editable
// copy; `approvedText` is the exact string a human authorised. Collapsing them
// would destroy the answer to "what did the owner actually approve?".
model ReplyDraft {
  id                   String           @id @default(uuid()) @db.Uuid
  threadId             String           @map("thread_id") @db.Uuid
  // The inbound this drafts a reply to. If a newer inbound arrives, the draft is
  // stale by definition and cannot be approved.
  inboundMessageId     String           @map("inbound_message_id") @db.Uuid
  revision             Int
  status               ReplyDraftStatus @default(queued)
  kind                 ReplyDraftKind   @default(reply)
  sourceConversationId String?          @map("source_conversation_id") @db.Uuid
  eligibleAt           DateTime         @default(now()) @map("eligible_at") @db.Timestamptz(3)
  expiresAt            DateTime?        @map("expires_at") @db.Timestamptz(3)
  promptVersion        Int?             @map("prompt_version")

  suggestedText String? @map("suggested_text")
  workingText   String? @map("working_text")
  approvedText  String? @map("approved_text")
  rationale     String?
  confidence    String?
  warnings      Json?

  modelId         String?   @map("model_id")
  runtimeThreadId String?   @map("runtime_thread_id")
  errorCode       String?   @map("error_code")
  errorMessage    String?   @map("error_message")
  retryAt         DateTime? @map("retry_at")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  sentAt          DateTime? @map("sent_at")
  failedAt        DateTime? @map("failed_at")
  supersededById  String?   @map("superseded_by_id") @db.Uuid

  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  thread             DmThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sourceConversation Conversation? @relation("FollowUpSource", fields: [sourceConversationId], references: [id], onDelete: Restrict)

  @@unique([threadId, revision])
  @@index([status, nextAttemptAt])
  @@index([threadId, createdAt])
  @@index([sourceConversationId, kind])
  @@map("reply_draft")
}

// The live Instagram access token, as a single row (id = 1).
//
// Lives in the DB rather than env because the refresh worker has to WRITE it: a
// process cannot rewrite its own Railway environment variables, so an env-only
// token can never renew itself. That is exactly how the 2026-07-26 expiry
// happened.
//
// env.IG_ACCESS_TOKEN is still the seed and the manual override — paste a
// freshly minted token there and it wins over a stale row on next boot.
model IgToken {
  id          Int      @id @default(1)
  accessToken String   @map("access_token")
  // Meta's authoritative expiry, from refresh_access_token's expires_in. Before
  // the first successful refresh this is an estimate (seeded as now + 60d).
  expiresAt   DateTime @map("expires_at")
  refreshedAt DateTime @map("refreshed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("ig_token")
}

