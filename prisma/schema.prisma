generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Keyword {
  id             String    @id @default(uuid()) @db.Uuid
  keyword        String
  mediaId        String?   @map("media_id")
  mediaCaption   String?   @map("media_caption")
  mediaPermalink String?   @map("media_permalink")
  // When the POST was published (Meta's timestamp), snapshotted at attach time —
  // not when the keyword was created. Ranks candidates when a cold DM has to pick
  // between several posts sharing a word: a DM carries no media context, so
  // "newest post wins" is the inference. A column rather than a join because
  // ReelMeta.postedAt covers reels only (140 reels, 0 carousels), so it cannot
  // date a carousel-scoped keyword. Null on the legacy global rows.
  mediaPostedAt  DateTime? @map("media_posted_at")
  resourceId     String    @map("resource_id") @db.Uuid
  publicReply    String    @map("public_reply")
  gateMessage    String    @map("gate_message")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  resource            Resource                     @relation(fields: [resourceId], references: [id])
  conversations       Conversation[]
  recoveryReminders   DmRecoveryReminder[]
  journeyIntents      JourneyIntent[]
  recoveryCandidates  RecoveryCandidate[]
  selectionExclusions RecoverySelectionExclusion[]
  upcomingAutomations UpcomingAutomation[]

  @@unique([keyword, mediaId])
  // The cold-DM fallback ranks post-scoped candidates for one word by post date.
  @@index([keyword, mediaPostedAt])
  @@map("keywords")
}

model Resource {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  // What this guide is for, in prose: the problem it solves, its shape (BOX and
  // Cardboard are COLLECTIONS of several activities, not one), and hard warnings
  // — Link/Book/Dough are bare Amazon affiliate lists and must never be offered
  // as parenting advice. Read by the LLM; the filterable facets are columns below.
  description  String?
  // What this resource IS: guide | recipes | activity | product_links.
  // The safety facet. `product_links` rows (Link, Book, Dough) are bare Amazon
  // affiliate links, not advice, and must be excluded by SQL — a struggling
  // parent handed an affiliate link is the worst routing failure available, so
  // it cannot be left to the model's judgment. Null = unclassified (orphan
  // drafts); the router selects kinds it wants rather than excluding ones it
  // doesn't, so null is never routed.
  kind         String?
  // Coarse routing bucket: sleep | eating | behavior | learning. A column, not
  // prose, so candidates narrow in SQL before the LLM reads anything — this is
  // what stops the car-seat guide surfacing on a feeding question.
  theme        String?
  // Age window in MONTHS, from the author's own words ("Sensory Play for
  // Babies", "18-24 MONTHS", "For Ages 1-3"). Months because parents state
  // infant age in months. NULL = no stated age, which means ELIGIBLE FOR
  // EVERYONE — never treat null as excluded, or real content becomes
  // unreachable.
  ageMinMonths Int?     @map("age_min_months")
  ageMaxMonths Int?     @map("age_max_months")
  createdAt    DateTime @default(now()) @map("created_at")

  messages            ResourceMessage[]
  keywords            Keyword[]
  guideDeliveries     GuideDelivery[]
  upcomingAutomations UpcomingAutomation[]

  @@index([theme, ageMinMonths, ageMaxMonths])
  @@map("resources")
}

enum UpcomingAutomationStatus {
  waiting
  bound
  needs_attention
  cancelled

  @@map("upcoming_automation_status")
}

model UpcomingAutomation {
  id             String                   @id @default(uuid()) @db.Uuid
  triggerWord    String                   @map("trigger_word")
  resourceId     String                   @map("resource_id") @db.Uuid
  publicReply    String                   @map("public_reply")
  gateMessage    String                   @map("gate_message")
  active         Boolean                  @default(true)
  status         UpcomingAutomationStatus @default(waiting)
  matchedMediaId String?                  @map("matched_media_id")
  keywordId      String?                  @map("keyword_id") @db.Uuid
  errorCode      String?                  @map("error_code")
  createdBy      String                   @map("created_by")
  lastAttemptAt  DateTime?                @map("last_attempt_at") @db.Timestamptz(3)
  retriedAt      DateTime?                @map("retried_at") @db.Timestamptz(3)
  boundAt        DateTime?                @map("bound_at") @db.Timestamptz(3)
  cancelledAt    DateTime?                @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  keyword  Keyword? @relation(fields: [keywordId], references: [id], onDelete: SetNull)

  @@index([resourceId])
  @@index([keywordId])
  @@index([status, createdAt])
  @@map("upcoming_automations")
}

enum ResourceMessageType {
  text
  image
  pdf

  @@map("resource_message_type")
}

model ResourceMessage {
  id         String              @id @default(uuid()) @db.Uuid
  resourceId String              @map("resource_id") @db.Uuid
  order      Int
  type       ResourceMessageType
  body       String?
  mediaUrl   String?             @map("media_url")
  // The words inside an image guide, transcribed. Images are stored under UUID
  // filenames, so `media_url` reveals nothing about the page's content, and 7
  // resources are image-ONLY (zero queryable text) — including `Picky`, a
  // 10-page "Toddler Feeding Handbook". Sits here rather than on Resource so
  // each page's text lives on the row holding that page's media_url.
  // Never read by the send path; delivery is unchanged. Null = not yet
  // transcribed, which is the backlog query.
  altText    String?             @map("alt_text")

  resource      Resource            @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  deliveryUnits GuideDeliveryUnit[]

  @@unique([resourceId, order])
  @@map("resource_messages")
}

enum ConversationState {
  awaiting_done
  completed
  expired

  @@map("conversation_state")
}

model Conversation {
  id                            String            @id @default(uuid()) @db.Uuid
  igUserId                      String            @map("ig_user_id")
  keywordId                     String            @map("keyword_id") @db.Uuid
  state                         ConversationState @default(awaiting_done)
  createdAt                     DateTime          @default(now()) @map("created_at")
  completedAt                   DateTime?         @map("completed_at")
  // When the gate DM was actually delivered (live or via retry). The DONE-window
  // and expiry are measured from this, not createdAt, so a gate delivered days
  // after the comment (retry) still opens a valid window. Null for legacy rows.
  gatedAt                       DateTime?         @map("gated_at")
  // When the follow-recheck worker measured this completed conversation's
  // follower outcome (fix #11). Null = not yet rechecked / not eligible.
  followRecheckedAt             DateTime?         @map("follow_rechecked_at")
  // Second, LATER reading of the same user (fix: does the guide follower stay?).
  // Tracked separately from followRecheckedAt so the two measurements never
  // overwrite each other — the whole point is comparing them.
  followThroughAt               DateTime?         @map("follow_through_at")
  // Follow status AT that later reading. Null until measured.
  followThroughIsFollower       Boolean?          @map("follow_through_is_follower")
  engagementFollowUpScheduledAt DateTime?         @map("engagement_follow_up_scheduled_at") @db.Timestamptz(3)
  // Set by reconciliation. Null means "not yet reconciled", never "no owner".
  canonicalIntentId             String?           @map("canonical_intent_id") @db.Uuid
  reconciliationReason          String?           @map("reconciliation_reason")
  reconciledAt                  DateTime?         @map("reconciled_at") @db.Timestamptz(3)

  keyword            Keyword              @relation(fields: [keywordId], references: [id])
  followUpDrafts     ReplyDraft[]         @relation("FollowUpSource")
  recoveryReminders  DmRecoveryReminder[]
  canonicalIntent    JourneyIntent?       @relation("ConversationCanonicalIntent", fields: [canonicalIntentId], references: [id], onDelete: SetNull)
  ownedIntents       JourneyIntent[]      @relation("IntentCanonicalConversation")
  journeyTriggers    JourneyTrigger[]
  recoveryCandidates RecoveryCandidate[]
  guideDeliveries    GuideDelivery[]

  @@index([igUserId, state])
  @@index([state, createdAt])
  @@index([canonicalIntentId])
  @@map("conversations")
}

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  journeyTriggers JourneyTrigger[] @relation("JourneyTriggerSourceLog")

  @@index([kind, createdAt])
  @@map("event_log")
}

model IgUser {
  id              String    @id // the Instagram-scoped user ID (IGSID)
  username        String?
  name            String?
  resolvedAt      DateTime? @map("resolved_at") // null = never successfully resolved
  // Follow intel — only readable once the user is in a messaging context (they've
  // DM'd us). Volatile, so refreshed on each resolve. Null = not yet checked.
  isFollower      Boolean?  @map("is_follower")
  followerCount   Int?      @map("follower_count")
  isVerified      Boolean?  @map("is_verified")
  followCheckedAt DateTime? @map("follow_checked_at")

  // Inferred audience origin from username/name (and optionally bio). A PROXY,
  // not measured geography — Meta gives no per-user country. Confidence is low
  // for Latin-script South Asian names a token match can miss; method records
  // how it was derived so a later bio pass can upgrade name-only guesses.
  inferredOrigin   String?                    @map("inferred_origin") // us_western | south_asian | other | unknown
  originConfidence String?                    @map("origin_confidence") // high | low
  originMethod     String?                    @map("origin_method") // classifier/prompt version, e.g. llm_v2
  originEvidence   String?                    @map("origin_evidence") // the token/script/bio that drove it
  originCheckedAt  DateTime?                  @map("origin_checked_at")
  audienceSegment  HistoricalAudienceSegment? @map("audience_segment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recoveryReminders        DmRecoveryReminder[]
  publicRecoveryDispatches PublicRecoveryDispatch[]

  @@index([audienceSegment, originMethod])
  @@map("ig_users")
}

model GateQueue {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  igUserId       String    @map("ig_user_id")
  commentId      String    @map("comment_id")
  mediaId        String?   @map("media_id")
  gateMessage    String    @map("gate_message")
  status         String    @default("pending") // pending | sent | exhausted | abandoned
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  commentAt      DateTime  @map("comment_at") // enforces the 7-day private-reply window
  nextAttemptAt  DateTime  @map("next_attempt_at")
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("gate_queue")
}

// ── Insights ─────────────────────────────────────────────────────────────────
// Reels live in the Graph API, not our DB, so everything here joins on the IG
// media id string (`mediaId`) — exactly like Keyword.mediaId — NOT a uuid FK.

// Anchor row, one per reel. Denormalizes the reel facts the Leaderboard needs so
// it renders without re-walking the Graph media list, plus the manual overrides
// and the cached fused US-fit score (sorted on, so kept on this lean row).
model ReelMeta {
  mediaId          String    @id @map("media_id")
  caption          String?
  permalink        String?
  thumbnailUrl     String?   @map("thumbnail_url")
  // The downloadable video. Omitted by Meta when the reel uses copyrighted/
  // licensed audio — absence is itself a weak "trending licensed audio" signal.
  mediaUrl         String?   @map("media_url")
  postedAt         DateTime? @map("posted_at") // IG timestamp; drives post-time-ET analysis
  mediaAudioType   String?   @map("media_audio_type") // MUSIC | ORIGINAL_SOUND (free Meta field)
  videoUnavailable Boolean   @default(false) @map("video_unavailable")

  // Manual overrides (drawer-editable). Override > derived when present.
  manualAudioType    String? @map("manual_audio_type")
  manualLangOverride String? @map("manual_lang_override")
  manualNote         String? @map("manual_note")

  // Cached fused result, denormalized for fast Leaderboard sort.
  usFitScore Int?      @map("us_fit_score") // 0..100
  confidence String? // high | low
  scoredAt   DateTime? @map("scored_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contentProfile ReelContentProfile?
  perfSnapshots  ReelPerformanceSnapshot[]
  geminiJob      GeminiJob?

  @@index([usFitScore])
  @@map("reel_meta")
}

// Gemini output, 1:1 with ReelMeta. Written once per (reel, promptVersion) and
// cached forever. Kept separate so the large immutable JSON blob doesn't bloat
// the row we sort the Leaderboard by, and re-analysis is a clean row replace.
model ReelContentProfile {
  mediaId       String @id @map("media_id")
  source        String // gemini | fallback
  promptVersion String @map("prompt_version")
  modelId       String @map("model_id")
  profile       Json // full structured content profile

  // Sub-scores lifted out of `profile` for querying / scoring.
  accentScore   Int?    @map("accent_score")
  settingScore  Int?    @map("setting_score")
  culturalScore Int?    @map("cultural_score")
  hookArchetype String? @map("hook_archetype")
  onScreenLang  String? @map("on_screen_lang")
  audioVibe     String? @map("audio_vibe")
  costUsd       Float?  @map("cost_usd")

  createdAt DateTime @default(now()) @map("created_at")

  reel ReelMeta @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)

  @@map("reel_content_profile")
}

// Per-reel Meta performance metrics over time. Time-series (metrics drift; several
// are "in development" and nullable) so we snapshot rather than overwrite.
model ReelPerformanceSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  mediaId            String   @map("media_id")
  capturedAt         DateTime @default(now()) @map("captured_at")
  views              Int?
  reach              Int?
  likes              Int?
  comments           Int?
  shares             Int?
  saved              Int?
  totalInteractions  Int?     @map("total_interactions")
  avgWatchTimeMs     Int?     @map("avg_watch_time_ms") // ig_reels_avg_watch_time
  // BIGINT, not INT4. This is CUMULATIVE watch time in milliseconds across a
  // reel's whole life, so it grows without bound while the reel keeps being
  // watched — a 140k-reach reel crosses INT4's 2,147,483,647 ceiling in about
  // seven weeks. Postgres then rejects the INSERT, and because every metric for
  // that reel shares one row, the reel silently stops being measured at all:
  // views, reach, likes, the lot. It cost this account its three biggest reels
  // for 25-47 days before a manual snapshot run surfaced the error.
  videoViewTotalTime BigInt?  @map("video_view_total_time") // ig_reels_video_view_total_time
  skipRate           Float?   @map("skip_rate") // reels_skip_rate
  raw                Json? // full payload incl. which metrics 400'd

  reel ReelMeta @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)

  @@index([mediaId, capturedAt])
  @@map("reel_performance_snapshot")
}

// Regular FEED media (carousel albums, images and non-Reel videos). Kept
// separate from ReelMeta because Meta exposes the lifetime `follows` insight
// for FEED media but not Reels. The baseline prevents historical lifetime
// follows from being assigned to the day tracking is first deployed.
model FeedPostMeta {
  mediaId            String    @id @map("media_id")
  mediaType          String?   @map("media_type")
  mediaProductType   String?   @map("media_product_type")
  caption            String?
  permalink          String?
  thumbnailUrl       String?   @map("thumbnail_url")
  postedAt           DateTime? @map("posted_at") @db.Timestamptz(3)
  baselineFollows    Int?      @map("baseline_follows")
  baselineCapturedAt DateTime? @map("baseline_captured_at") @db.Timestamptz(3)
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  followSnapshots FeedFollowDailySnapshot[]

  @@index([postedAt])
  @@map("feed_post_meta")
}

// The cumulative lifetime follow count for one feed post, sampled throughout
// the day but stored as one latest row per Pacific analytics day. A nullable value is
// deliberate: unavailable/failed is unknown and must never be coerced to zero.
// A database CHECK keeps day aligned with capturedAt across worker versions.
model FeedFollowDailySnapshot {
  mediaId    String   @map("media_id")
  day        DateTime @db.Date
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  follows    Int?
  status     String // ok | unavailable | failed

  feedPost FeedPostMeta @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)

  @@id([mediaId, day])
  @@index([day])
  @@map("feed_follow_daily_snapshot")
}

// Singleton (`scope = "feed"`) with the immutable attribution start and the
// latest collection-health summary used by the diagnostic API.
model FeedFollowCollectorState {
  scope            String    @id
  startedAt        DateTime  @map("started_at") @db.Timestamptz(3)
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastCompletedAt  DateTime? @map("last_completed_at") @db.Timestamptz(3)
  lastStatus       String?   @map("last_status") // running | success | partial | failed
  eligibleCount    Int       @default(0) @map("eligible_count")
  writtenCount     Int       @default(0) @map("written_count")
  unavailableCount Int       @default(0) @map("unavailable_count")
  failedCount      Int       @default(0) @map("failed_count")
  lastError        String?   @map("last_error")
  leaseOwner       String?   @map("lease_owner")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feed_follow_collector_state")
}

// Account-level country split over time (no mediaId — Meta gives geo only at the
// account level). One row per (stage, run). Spine of the geo trend + experiments.
model GeoDemographicSnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  stage        String // follower | engaged | reached
  capturedAt   DateTime @default(now()) @map("captured_at")
  timeframe    String   @default("last_90_days")
  counts       Json // { US: n, IN: n, ... }
  usPct        Float?   @map("us_pct")
  inPct        Float?   @map("in_pct")
  totalCounted Int?     @map("total_counted")

  @@index([stage, capturedAt])
  @@map("geo_demographic_snapshot")
}

// The account's TRUE follower total, captured on every snapshot tick.
//
// GeoDemographicSnapshot cannot carry this job. follower_demographics counts only
// the followers Meta HAS demographic data for, inside its top ~45 countries, and
// Meta refreshes it on its own irregular schedule — so diffing it both
// undercounts real growth and collapses several calendar days into one bar when
// a refresh is skipped. followers_count has neither problem: it is the live
// number Instagram shows on the profile, with no top-N cutoff and no ~48h
// demographics lag, so consecutive daily rows give an EXACT net-add series.
//
// Deliberately its own table rather than a column on GeoDemographicSnapshot:
// that table writes one row PER STAGE per run, and this figure is account-wide.
model FollowerTotalSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  capturedAt     DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  followersTotal Int      @map("followers_total")

  @@index([capturedAt])
  @@map("follower_total_snapshot")
}

// Meta's daily follows/unfollows ledger (`follows_and_unfollows`), one row per
// Pacific analytics day.
//
// followers_count answers "how many net" exactly; only this answers "out of how
// many gained and how many lost". A day that gained 400 and lost 380 is
// indistinguishable from one that gained 20 in the net figure, and they are very
// different days.
//
// Unlike followers_count this IS backfillable — the metric answers historical
// since/until windows — so the worker fills gaps behind itself instead of only
// capturing forward. `status` follows FeedFollowDailySnapshot's pattern: a day
// Meta declines to answer is RECORDED as unavailable rather than left missing,
// so the backfill does not re-request it on every tick forever.
model FollowerChurnDaySnapshot {
  day        DateTime @id @db.Date
  follows    Int?
  unfollows  Int?
  status     String // ok | unavailable
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("follower_churn_day_snapshot")
}

// Gemini analysis queue. Queue state kept separate from the result (same reason
// GateQueue is separate from Conversation). Mirrors GateQueue's shape/backoff.
model GeminiJob {
  mediaId       String   @id @map("media_id")
  status        String   @default("pending") // pending | running | done | failed | skipped
  attempts      Int      @default(0)
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  reel ReelMeta @relation(fields: [mediaId], references: [mediaId], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("gemini_job")
}

// Tab 3. Created now so the table ships in one migration; used in Phase 4.
model Experiment {
  id            String    @id @default(uuid()) @db.Uuid
  hypothesis    String
  variable      String
  reelMediaIds  String[]  @map("reel_media_ids")
  status        String    @default("running") // running | inconclusive | confirmed | busted
  baselineUsPct Float?    @map("baseline_us_pct") // reached-US% at creation (90d, legacy)
  startedAt     DateTime  @default(now()) @map("started_at")
  postedAt      DateTime? @map("posted_at")
  measuredUsPct Float?    @map("measured_us_pct")
  conclusion    String?

  // ── Auto-experiments (origin="auto") ──────────────────────────────────────
  // One reel, auto-created by the snapshot worker once the reel has a Gemini
  // profile. Tracks the responsive 14d ENGAGED-US% before→after. Never
  // auto-decides a verdict unless the reel dominated its window's reach (else
  // account-level geo can't isolate it) — see suggestedVerdict/attributionConfidence.
  origin                String    @default("manual") // manual | auto
  mediaId               String?   @map("media_id") // the reel this auto-experiment tracks
  usFitScore            Int?      @map("us_fit_score") // Gemini score at creation ("what changed")
  culturalCues          String[]  @map("cultural_cues") // US cues Gemini saw, snapshotted
  baselineEngagedUsPct  Float?    @map("baseline_engaged_us_pct") // 14d engaged-US% at post time
  measuredEngagedUsPct  Float?    @map("measured_engaged_us_pct") // 14d engaged-US% after the window
  windowReachShare      Float?    @map("window_reach_share") // this reel's share of its 14d window reach (0..1)
  suggestedVerdict      String?   @map("suggested_verdict") // confirmed | busted | inconclusive (a SUGGESTION)
  attributionConfidence String?   @map("attribution_confidence") // high | low — can we isolate this reel?
  measuredAt            DateTime? @map("measured_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([origin, mediaId])
  @@map("experiment")
}

// ── DM capture + AI reply drafts ─────────────────────────────────────────────
// Conversation (above) models an AUTOMATION JOURNEY: one keyword, one gate, one
// guide. It is not a thread and never held the participant's own words. These
// three models add the real message history so an owner can read a conversation
// and approve a reply. Conversation keeps its current meaning untouched.

enum DmDirection {
  inbound
  outbound

  @@map("dm_direction")
}

enum DmMessageType {
  text
  image
  video
  audio
  file
  unknown

  @@map("dm_message_type")
}

// Where an outbound message came from. Lets the drawer distinguish "the bot sent
// this gate" from "the owner approved this reply", and is the audit anchor for
// anything AI-assisted.
enum DmMessageSource {
  instagram_user
  keyword_automation
  guide_automation
  ai_approved
  manual_external
  unknown

  @@map("dm_message_source")
}

enum ReplyDraftStatus {
  queued
  generating
  pending_approval
  generation_failed
  dismissed
  superseded
  sending
  sent
  send_failed
  send_uncertain
  expired

  @@map("reply_draft_status")
}

enum ReplyDraftKind {
  reply
  engagement_follow_up

  @@map("reply_draft_kind")
}

model DmThread {
  id                     String    @id @default(uuid()) @db.Uuid
  igAccountId            String    @map("ig_account_id")
  igUserId               String    @map("ig_user_id")
  username               String?
  name                   String?
  // A plain scalar, NOT a relation: DmMessage already points at DmThread, and a
  // second FK back would make every insert a circular write.
  latestInboundMessageId String?   @map("latest_inbound_message_id") @db.Uuid
  // True from the moment an inbound lands until an automation or the owner
  // answers it. The Conversations "Needs reply" filter reads exactly this.
  needsReply             Boolean   @default(false) @map("needs_reply")
  lastMessageAt          DateTime  @map("last_message_at")
  lastInboundAt          DateTime? @map("last_inbound_at")
  lastOutboundAt         DateTime? @map("last_outbound_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  messages        DmMessage[]
  drafts          ReplyDraft[]
  guideDeliveries GuideDelivery[]

  @@unique([igAccountId, igUserId])
  @@index([needsReply, lastInboundAt])
  @@index([lastMessageAt])
  @@index([lastInboundAt])
  @@map("dm_thread")
}

model DmMessage {
  id                            String          @id @default(uuid()) @db.Uuid
  threadId                      String          @map("thread_id") @db.Uuid
  // Meta's `mid`. Unique, so replaying a webhook cannot double-insert — this is
  // the whole idempotency story for inbound capture. Null for a send whose
  // response carried no id.
  instagramMessageId            String?         @unique @map("instagram_message_id")
  direction                     DmDirection
  type                          DmMessageType
  source                        DmMessageSource
  text                          String?
  mediaUrl                      String?         @map("media_url")
  // Meta's own timestamp, not ours: ordering must survive a delayed webhook.
  instagramTimestamp            DateTime        @map("instagram_timestamp")
  seenAt                        DateTime?       @map("seen_at") @db.Timestamptz(3)
  deletedAt                     DateTime?       @map("deleted_at") @db.Timestamptz(3)
  // Durable safety inbox: every new inbound remains pending until campaign-health
  // classification succeeds. Historical dispatch drains this before opening a batch.
  campaignHealthCapturedAt      DateTime?       @map("campaign_health_captured_at") @db.Timestamptz(3)
  campaignHealthCaptureAttempts Int             @default(0) @map("campaign_health_capture_attempts")
  campaignHealthNextAttemptAt   DateTime?       @map("campaign_health_next_attempt_at") @db.Timestamptz(3)
  campaignHealthLastError       String?         @map("campaign_health_last_error")
  createdAt                     DateTime        @default(now()) @map("created_at")

  thread            DmThread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  recoveryReminders DmRecoveryReminder[]

  @@index([threadId, instagramTimestamp])
  @@index([direction, instagramTimestamp])
  @@index([direction, campaignHealthCapturedAt, campaignHealthNextAttemptAt])
  @@map("dm_message")
}

