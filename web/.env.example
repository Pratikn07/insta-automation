# Copy to .env.local for local dev and for a representative production build.
#
# These are REQUIRED at build time, not just at runtime. src/lib/supabase.ts throws
# on import when they are missing, and the bundler then tree-shakes every module
# downstream of it — `npm run build` still exits 0 but emits a ~356 kB bundle with
# no application code in it, and no chunk-size warning. With these set the bundle is
# ~890 kB and the expected "chunks are larger than 500 kB" warning appears.
#
# Vercel supplies all three in production (see DEPLOY.md), so this only affects
# local builds.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of the Railway API, e.g. https://your-api.up.railway.app
VITE_API_URL=
